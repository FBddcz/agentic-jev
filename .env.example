# Optional: the demo works without a key. Node reads this via --env-file.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
PORT=8787

# Optional general-web search. Papers and tech sources need no search key.
TAVILY_API_KEY=
SEARCH1API_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional photo try-on worker (CUDA host or an SSH tunnel). See docs/TRY_ON.md.
TRYON_BASE_URL=http://127.0.0.1:8789
