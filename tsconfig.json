{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsxImportSource": "@agentic/i18n",
    "paths": {
      "@agentic/i18n/*": ["./src/i18n/*"]
    }
  },
  "include": ["src", "server", "tests", "scripts", "vite.config.ts"]
}
